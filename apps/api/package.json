{
	"name": "@codekeat/api",
	"version": "0.0.0",
	"private": true,
	"files": [
		"dist"
	],
	"type": "module",
	"imports": {
		"#features/auth": "./dist/features/auth/index.js",
		"#features/github": "./dist/features/github/index.js",
		"#features/models": "./dist/features/modelos/index.js",
		"#features/repository-policy": "./dist/features/repository-policy/index.js",
		"#features/review": "./dist/features/review/index.js",
		"#core/workflows/*": "./dist/core/workflows/*.js",
		"#integrations/gemini": "./dist/integrations/gemini/index.js",
		"#integrations/takeat-mcp": "./dist/integrations/takeat-mcp/index.js",
		"#shared/http": "./dist/shared/http/index.js",
		"#shared/database": "./dist/shared/database/index.js"
	},
	"scripts": {
		"build": "tsc --noEmit false --outDir dist",
		"clean": "rm -rf dist .turbo .cache coverage",
		"dev": "tsx ./node_modules/probot/bin/probot.js run ./src/index.ts",
		"env:check": "tsx --env-file=.env ./src/bootstrap/check-environment.ts",
		"start": "probot run ./dist/index.js",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@codekeat/database": "workspace:*",
		"@google/genai": "catalog:",
		"@modelcontextprotocol/sdk": "catalog:",
		"@octokit/rest": "catalog:",
		"@opentelemetry/api": "catalog:",
		"argon2": "catalog:",
		"dotenv": "catalog:",
		"drizzle-orm": "catalog:",
		"hono": "catalog:",
		"minimatch": "catalog:",
		"p-queue": "catalog:",
		"parse-diff": "catalog:",
		"pino": "catalog:",
		"probot": "catalog:",
		"yaml": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@codekeat/typescript-config": "workspace:*",
		"@types/node": "catalog:",
		"smee-client": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
