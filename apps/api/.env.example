NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

APP_ID=
# Configure uma das duas opções. PRIVATE_KEY_PATH evita copiar o PEM para este arquivo.
PRIVATE_KEY=
PRIVATE_KEY_PATH=
WEBHOOK_SECRET=
WEBHOOK_PROXY_URL=

GOOGLE_API_KEY=
TAKEAT_MCP_URL=https://mcp.takeat.app/mcp
TAKEAT_MCP_TOKEN_URL=https://mcp.takeat.app/oauth/token
TAKEAT_MCP_CLIENT_ID=
TAKEAT_MCP_CLIENT_SECRET=
DASHBOARD_API_TOKEN=
INITIAL_ADMIN_EMAIL=admin@codekeat.local
INITIAL_ADMIN_PASSWORD=

DATABASE_PATH=../../packages/database/data/codekeat.db

REVIEW_MODE=advisory
# Quantidade máxima de PRs analisados ao mesmo tempo nesta API.
REVIEW_CONCURRENCY=5
# Unidades por PR e chamadas reais ao modelo compartilham limites diferentes.
REVIEW_UNIT_CONCURRENCY=2
REVIEW_MODEL_CONCURRENCY=5
# Opcionais: limites locais por minuto. Consulte a quota do seu projeto Google.
GOOGLE_REQUESTS_PER_MINUTE=
GOOGLE_INPUT_TOKENS_PER_MINUTE=
ALLOWED_GITHUB_ACCOUNTS=takeat,seu-usuario
