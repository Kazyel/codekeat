[Unit]
Description=Codekeat Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/codekeat
ExecStartPre=/usr/bin/docker compose pull
ExecStart=/usr/bin/docker compose up --detach --no-build --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
